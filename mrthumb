local function colourMatches(actual, expected)
    return math.abs(actual.R - expected.R) < 0.02
        and math.abs(actual.G - expected.G) < 0.02
        and math.abs(actual.B - expected.B) < 0.02
end

local function readRebirthState()
    local _, indicator = getRebirthControl()

    if not indicator or not indicator:IsA("GuiObject") then
        return nil
    end

    local colour = indicator.BackgroundColor3

    if colourMatches(colour, Color3.fromRGB(102, 255, 0)) then
        return true
    elseif colourMatches(colour, Color3.fromRGB(255, 50, 0)) then
        return false
    end

    return nil
end

local function getRebirthButton()
    local container = getRebirthControl()

    if not container or not isShown(container) then
        error("Auto Rebirth control is not visible.")
    end

    if container:IsA("GuiButton") then
        return container
    end

    local candidates = {}
    for _, object in ipairs(container:GetDescendants()) do
        if object:IsA("GuiButton") and isShown(object) then
            table.insert(candidates, object)
        end
    end

    if #candidates == 0 then
        error("No clickable GuiButton found inside " .. container:GetFullName())
    end

    for _, object in ipairs(candidates) do
        if object.Name == "Toggle" or object.Name == "AutoRebirthBtn" then
            return object
        end
    end

    return candidates[1]
end

local function sendClick(target)
    if not target or not isShown(target) then
        error("The Auto Rebirth target is not visible.")
    end

    if not target:IsA("GuiButton") then
        error("Auto Rebirth target is not a GuiButton: " .. target:GetFullName())
    end

    -- IMPORTANT: only perform ONE activation attempt.
    -- Firing both Activated and MouseButton1Click can toggle the same switch twice.
    local activated = pcall(function()
        target:Activate()
    end)

    if activated then
        task.wait(0.25)
        if readRebirthState() == true then
            return true
        end
    end

    -- Executor fallback: choose exactly one signal, not both.
    -- This avoids an ON->OFF double toggle when the game has handlers on both events.
    if typeof(getconnections) == "function" and typeof(firesignal) == "function" then
        local signal = target.Activated
        local okConnections, connections = pcall(getconnections, signal)

        if okConnections and type(connections) == "table" and #connections > 0 then
            pcall(function()
                firesignal(signal)
            end)

            task.wait(0.25)

            if readRebirthState() == true then
                return true
            end
        end
    end

    return false
end
