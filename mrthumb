-- Automatically enable the game's Auto Rebirth setting.
-- This only clicks when the game clearly reports that it is OFF.
local function ensureRebirthOn()
    if closed or mode ~= "bag" or rebirthBusy or clickBusy then
        return false
    end

    -- Only verify/click once per Hacker Bag session or recovery.
    if autoRebirthEnsured then
        return true
    end

    local current = readRebirthState()

    if current == nil then
        return false
    end

    if current == true then
        refreshRebirthButton()
        return true
    end

    rebirthBusy = true
    refreshRebirthButton()

    local success, reason = withPanelHidden(function()
        local latest = readRebirthState()

        if latest == nil then
            error("Auto Rebirth state is unavailable.")
        end

        if latest == false then
            -- The game's toggle can update its visual state slightly after
            -- the activation signal fires, so do not treat an immediate
            -- false read as a callback failure. The confirmation check
            -- below is the authoritative result.
            sendClick(getRebirthButton())
        end
    end)

    if closed then
        return false
    end

    if success then
        local deadline = os.clock() + 3

        while not closed
            and readRebirthState() ~= true
            and os.clock() < deadline do
            task.wait(0.1)
        end

        local enabled = readRebirthState() == true

        if enabled then
            autoRebirthEnsured = true
            lastAction = "Auto Rebirth enabled"
            showNotification("Auto Rebirth enabled")
        end
        updateLiveMonitor()

        rebirthHint.Text = enabled
            and "Auto Rebirth automatically enabled."
            or "Auto Rebirth click wasn't confirmed."

        rebirthBusy = false
        refreshRebirthButton()
        return enabled
    end

    rebirthBusy = false
    refreshRebirthButton()
    rebirthHint.Text = "Auto Rebirth activation failed."
    warn("Auto Rebirth:", reason)
    return false
end

local function waitFor(token, character, timeout, predicate)
    local deadline = os.clock() + timeout

    repeat
        if not isCurrent(token, character) then
            return false
        end

        if predicate() then
            return true
        end

        task.wait(0.1)
    until os.clock() >= deadline

    return false
end

