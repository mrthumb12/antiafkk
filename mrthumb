local function runWatchdog()
    if closed then return end
    local character, root = getCharacter()
    local ok = (gui.Parent == playerGui) and (mode ~= nil) and (character ~= nil) and (root ~= nil)

    if ok and mode == "bag" then
        ok = (root.Position - activeBagCFrame.Position).Magnitude <= 60
    elseif ok and mode == "wins" then
        ok = true
    elseif ok and mode == "coop" then
        ok = (root.Position - ARENA).Magnitude <= 275 and align ~= nil
    end

    watchdogStatus = ok and "OK" or "ATTENTION"
    lastWatchdog = os.clock()
    updateLiveMonitor()

    if not ok and mode and farmForever and autoRecover and not recovering then
        showNotification("Watchdog detected a problem")
    end
end

connect(RunService.Heartbeat, function(delta)
    if mode then
        elapsed += delta

        local character, root = getCharacter()

        if character ~= activeCharacter or not root then
            if farmForever and autoRecover and desiredMode then
                pauseForRecovery("Recovering • Waiting for your character...")
            else
                stopFarm("Stopped • Character changed or died.")
            end
        else
            if miscWalkSpeedEnabled then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then humanoid.WalkSpeed = miscWalkSpeed end
            end

            if noclipEnabled then
                for _, object in ipairs(character:GetDescendants()) do
                    if object:IsA("BasePart") then object.CanCollide = false end
                end
            end

            if mode == "wins" then
            -- Auto Farm Wins controls its own position and does not use the Co-op hover helper.
            -- Do not let the normal farm watchdog stop the stage route while it is progressing.
            if winsCollecting then
                lastAction = "Collecting free wins"
                watchdogStatus = "OK"
            else
                watchdogStatus = "OK"
            end
        elseif mode == "bag" then
            -- Keep the watchdog tied to whichever bag is currently selected.
            if (root.Position - activeBagCFrame.Position).Magnitude > 50 then
                if farmForever and autoRecover and not recovering and os.clock() >= nextRecoveryAllowed then
                    nextRecoveryAllowed = os.clock() + recoveryCooldown
                    recovering = true
                    lastAction = "Recovering"
                    updateLiveMonitor()
                    status.Text = "Recovering • Returning to the best unlocked bag..."
                    task.spawn(function()
                        task.wait(0.4)

                        if closed or desiredMode ~= "bag" or not farmForever or not autoRecover then
                            recovering = false
                            return
                        end

                        startBag(true)
                        recovering = false
                    end)
                else
                    stopFarm("Stopped • You left the selected training bag.")
                end
            elseif os.clock() - bestBagScanAt >= BEST_BAG_RESCAN_INTERVAL then
                local best = getBestUnlockedBag()

                if best and best.multiplier > activeBagMultiplier then
                    setActiveBag(best)
                    status.Text =
                        "AUTO FARM BAG • Better bag unlocked!\n"
                        .. best.name .. " • " .. best.multiplierText

                    local switched = pcall(function()
                        moveCharacter(character, root, activeBagCFrame)
                    end)

                    if switched then
                        showNotification(
                            "Upgraded to " .. best.name
                        )
                    end
                end
            end
        elseif align then
            if root ~= heldRoot or not align.Parent then
                if farmForever and autoRecover and desiredMode == "coop" then
                    pauseForRecovery("Recovering • Co-op character state changed...")
                else
                    stopFarm("Stopped • Hover constraint changed.")
                end
            elseif (root.Position - ARENA).Magnitude > 250 then
                stopFarm("Stopped • You moved away from the recorded arena.")
            else
                align.Position = Vector3.new(
                    root.Position.X,
                    baseline + hoverHeight,
                    root.Position.Z
                )
            end
        end
        end
    end

    refresh += delta
    autoRebirthCheck += delta

    if os.clock() - lastWatchdog >= 2 then
        runWatchdog()
    end

    if refresh < 0.25 then
        return
    end
    refresh = 0

    local seconds = math.floor(elapsed)

    timer.Text = string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60,
        seconds % 60
    )

    refreshRebirthButton()

    if mode == "coop" and align and heldRoot then
        status.Text = string.format(
            "CO-OP FARM ON • Target +%d studs\nObserved height: %+.1f • Combat unverified.",
            hoverHeight,
            heldRoot.Position.Y - baseline
        )
    end
end)

connect(player.CharacterRemoving, function()
    if desiredMode and farmForever and autoRecover then
        pauseForRecovery("Respawning • Farm paused; recovery is armed.")
    else
        stopFarm("Respawning • Farming helpers stopped.")
    end
end)

connect(player.CharacterAdded, function(character)
    if closed or not desiredMode or not farmForever or not autoRecover then
        return
    end

    recovering = true

    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        local root = character:WaitForChild("HumanoidRootPart", 10)

        if not humanoid or not root or closed then
            recovering = false
            return
        end

        task.wait(0.6)

        local newHumanoid = character:FindFirstChildOfClass("Humanoid")
        if newHumanoid and miscWalkSpeedEnabled then
            newHumanoid.WalkSpeed = miscWalkSpeed
        end
        if noclipEnabled then
            cacheCollision(character)
        end

        if closed or not desiredMode or not farmForever or not autoRecover then
            recovering = false
            return
        end

        local selected = desiredMode

        if selected == "bag" then
            status.Text = "Recovering • Returning to best unlocked bag..."
            startBag(true)
        elseif selected == "coop" then
            status.Text = "Recovering • Restarting Co-op sequence..."
            startCoop(true)
        elseif selected == "wins" then
            status.Text = "Recovering • Restarting Auto Farm Wins..."
            startWins(true)
        end

        recovering = false
    end)
end)

