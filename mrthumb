local function getBestUnlockedBag()
    local best = nil

    for _, mapName in ipairs({
        "Map",
        "MapTest",
        "Map3",
        "Map4",
        "Map5",
        "Map6",
        "Map7",
    }) do

        local map = workspace:FindFirstChild(mapName)
        local zoneFolder = map and map:FindFirstChild("TrainingZone")

        if zoneFolder then
            for _, zone in ipairs(zoneFolder:GetChildren()) do
                if zone:IsA("Model")
                    and string.match(zone.Name, "^TrainingZone%d+$") then

                    local hitbox = zone:FindFirstChild("Hitbox")
                    local billboard = hitbox and hitbox:FindFirstChild("TrainingZoneBillboard")
                    local statusLabel = billboard and billboard:FindFirstChild("StatusLabel")
                    local multiplierLabel = billboard and billboard:FindFirstChild("MultiplierLabel")
                    local bag = zone:FindFirstChild("PunchingBag")

                    local statusText = statusLabel and statusLabel.Text or ""
                    local multiplierText = multiplierLabel and multiplierLabel.Text or ""

                    if string.lower(statusText) == "unlocked" and bag then
                        local multiplier = parsePowerMultiplier(multiplierText)
                        local ok, pivot = pcall(function()
                            return bag:GetPivot()
                        end)

                        if ok and pivot then
                            if not best or multiplier > best.multiplier then
                                best = {
                                    name = zone.Name,
                                    zoneId = zone:GetAttribute("ZoneId"),
                                    multiplier = multiplier,
                                    multiplierText = multiplierText,
                                    cframe = pivot,
                                    path = zone:GetFullName(),
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    if best then
        bestBagScanAt = os.clock()
    end

    return best
end

