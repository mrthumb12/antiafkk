local function findPath(names)
    local object = playerGui

    for _, name in ipairs(names) do
        object = object:FindFirstChild(name)
        if not object then
            return nil
        end
    end

    return object
end

isShown = function(object)
    if not object or not object:IsDescendantOf(playerGui) then
        return false
    end

    while object and object ~= playerGui do
        if object:IsA("GuiObject") and not object.Visible then
            return false
        end

        if object:IsA("ScreenGui") and not object.Enabled then
            return false
        end

        object = object.Parent
    end

    return true
end

local function findStartButton()
    local label = findPath({
        "ScreenGui", "Menus", "EndlessJoin",
        "Container", "Main", "Join", "TextLabel",
    })

    if not label or not label:IsA("TextLabel")
        or label.Text ~= "Start" or not isShown(label) then
        return nil
    end

    local target = label:FindFirstAncestorWhichIsA("GuiButton")

    if target and target.AbsoluteSize.X > 0
        and target.AbsoluteSize.Y > 0 then
        return target
    end

    return nil
end

