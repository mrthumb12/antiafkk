local function setEnabled(value)
    enabled = value

    toggle.Text = enabled and "TURN OFF" or "TURN ON"
    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(52, 91, 111)
        or Color3.fromRGB(117, 82, 196)

    status.Text = enabled and "ON • LISTENING FOR IDLE" or "OFF"
    status.TextColor3 = enabled
        and Color3.fromRGB(115, 225, 237)
        or Color3.fromRGB(160, 170, 193)

    detail.Text = enabled
        and "Input is attempted when Roblox reports idle."
        or "Paused. No new input attempts."
end

connect(toggle.Activated, function()
    setEnabled(not enabled)
end)

connect(player.Idled, function()
    if not enabled then
        return
    end

    attempts += 1
    counter.Text = "Input attempts: " .. attempts

    local success = pcall(function()
        local camera = workspace.CurrentCamera
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(
            Vector2.new(0, 0),
            camera and camera.CFrame or CFrame.new()
        )
    end)

    if success then
        detail.Text = "Input call completed • acceptance unverified."
    else
        setEnabled(false)
        status.Text = "INPUT UNAVAILABLE"
        detail.Text = "This environment blocked the input call."
    end
end)

local refresh = 0
connect(RunService.Heartbeat, function(delta)
    if enabled then
        elapsed += delta
    end

    refresh += delta
    if refresh < 0.25 then
        return
    end
    refresh = 0

    local seconds = math.floor(elapsed)
    timer.Text = string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60,
        seconds % 60
    )
end)

local dragging = false
local dragInput
local dragStart
local panelStart

connect(title.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragInput = input
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        panelStart = panel.AbsolutePosition
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not dragging then
        return
    end

    local isMouse = dragInput.UserInputType
        == Enum.UserInputType.MouseButton1

    if (isMouse and input.UserInputType == Enum.UserInputType.MouseMovement)
        or input == dragInput then
        local position = Vector2.new(input.Position.X, input.Position.Y)
        local target = panelStart + position - dragStart
        local camera = workspace.CurrentCamera

        if camera then
            local viewport = camera.ViewportSize
            target = Vector2.new(
                math.clamp(target.X, 0, math.max(0, viewport.X - 340)),
                math.clamp(target.Y, 0, math.max(0, viewport.Y - 285))
            )
        end

        panel.Position = UDim2.fromOffset(target.X, target.Y)
    end
end)

connect(UserInputService.InputEnded, function(input)
    if input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

gui.Destroying:Connect(function()
    enabled = false
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
end)

connect(close.Activated, function()
    gui:Destroy()
end)
