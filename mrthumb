-- Drag the heading with the mouse.
local dragging = false
local dragStart
local panelStart

connect(title.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = UIS:GetMouseLocation()
        panelStart = panel.AbsolutePosition
    end
end)

connect(UIS.InputChanged, function(input)
    if not dragging
        or input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local target = panelStart + UIS:GetMouseLocation() - dragStart
    local camera = workspace.CurrentCamera

    if camera then
        local viewport = camera.ViewportSize
        target = Vector2.new(
            math.clamp(target.X, 0, math.max(0, viewport.X - 360)),
            math.clamp(target.Y, 0, math.max(0, viewport.Y - 380))
        )
    end

    panel.Position = UDim2.fromOffset(target.X, target.Y)
end)

connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

