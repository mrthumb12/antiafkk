connect(player.Idled, function()
    if not mode then
        return
    end

    local token = generation
    attempts += 1
    counter.Text = "Idle input attempts: " .. attempts

    local success, reason = pcall(function()
        local camera = workspace.CurrentCamera
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(
            Vector2.new(0, 0),
            camera and camera.CFrame or CFrame.new()
        )
    end)

    if not success and generation == token then
        stop("Stopped • Idle input unavailable in this environment.")
        warn("AFK input:", reason)
    end
end)

local refresh = 0

connect(RunService.Heartbeat, function(delta)
    if mode then
        elapsed += delta

        local character, root = getCharacter()

        if character ~= activeCharacter or not root then
            stop("Stopped • Character changed or died.")
        elseif mode == "bag" then
            if (root.Position - HACKER_BAG.Position).Magnitude > 50 then
                stop("Stopped • You left the Hacker Bag area.")
            end
        elseif align then
            if root ~= heldRoot or not align.Parent then
                stop("Stopped • Hover constraint changed.")
            elseif (root.Position - ARENA).Magnitude > 250 then
                stop("Stopped • You moved away from the recorded arena.")
            else
                align.Position = Vector3.new(
                    root.Position.X,
                    baseline + hoverHeight,
                    root.Position.Z
                )
            end
        end
    end

    refresh += delta
    if refresh < 0.25 then
        return
    end
    refresh = 0

    local seconds = math.floor(elapsed)

    timer.Text = string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60,
        seconds % 60
    )

    if mode == "coop" and align and heldRoot then
        status.Text = string.format(
            "CO-OP FARM ON • Target +%d studs\nObserved height: %+.1f • Verify combat manually.",
            hoverHeight,
            heldRoot.Position.Y - baseline
        )
    end
end)

