local function withPanelHidden(action)
    if clickBusy or closed then
        return false, "Another UI action is busy."
    end

    clickBusy = true
    local wasEnabled = gui.Enabled
    gui.Enabled = false

    local success, reason = pcall(function()
        task.wait(0.1)

        if not closed then
            action()
        end

        task.wait(0.1)
    end)

    if not closed and gui.Parent then
        gui.Enabled = wasEnabled
    end

    clickBusy = false
    return success, reason
end

