local function parsePowerMultiplier(textValue)
    if type(textValue) ~= "string" then
        return 0
    end

    local cleaned = textValue
        :upper()
        :gsub(",", "")
        :gsub("%s+", "")

    local numberText, suffix = string.match(
        cleaned,
        "([%+%-]?%d+%.?%d*)XPOWER"
    )

    if not numberText then
        numberText, suffix = string.match(
            cleaned,
            "([%+%-]?%d+%.?%d*)([A-Z]+)XPOWER"
        )
    end

    if not numberText then
        return tonumber(string.match(cleaned, "([%+%-]?%d+%.?%d*)")) or 0
    end

    local base = tonumber(numberText) or 0
    if suffix and SUFFIX_MULTIPLIERS[suffix] then
        return base * SUFFIX_MULTIPLIERS[suffix]
    end

    return base
end

local function getLabelText(root, wantedName)
    if not root then return nil end

    for _, obj in ipairs(root:GetDescendants()) do
