local function stopFarm(message, keepIntent)
    generation += 1
    mode = nil
    activeCharacter = nil
    clearHover()
    recovering = false
    lastAction = "Stopped"
    watchdogStatus = "IDLE"
    updateLiveMonitor()

    if not keepIntent then
        desiredMode = nil
    end

    if not closed then
        updateFarmButtons()
        status.Text = message
            or "OFF • Helper stopped. Game training may continue."
    end
end

local function begin(selectedMode, character, preserveSession)
    desiredMode = selectedMode
    stopFarm(nil, true)
    desiredMode = selectedMode
    mode = selectedMode
    activeCharacter = character

    -- Auto Rebirth is ensured once per Hacker Bag session/recovery,
    -- rather than being clicked repeatedly every second.
    if selectedMode == "bag" then
        autoRebirthEnsured = false
    end

    if not preserveSession then
        elapsed = 0
        attempts = 0
        counter.Text = "Idle input attempts: 0"
    end

    updateFarmButtons()
    return generation
end

local function pauseForRecovery(message)
    generation += 1
    mode = nil
    activeCharacter = nil
    clearHover()

    if not closed then
        updateFarmButtons()
        status.Text = message or "Recovering • Waiting for character..."
    end
end

