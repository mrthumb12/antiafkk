local function startWins(isRecovery)
    if clickBusy or rebirthBusy then
        status.Text = "Wait for the current UI action to finish."
        return
    end

    local character, root = getCharacter()
    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    local token = os.clock()
    winsLoopToken = token
    begin("wins", character, isRecovery == true)
    winsStageIndex = 1
    winsHighestStage = 0
    lastAction = isRecovery and "Wins recovery" or "Wins farming started"
    if isRecovery then totalRecoveries += 1 end
    updateLiveMonitor()
    showNotification(isRecovery and "Auto Farm Wins recovery" or "Auto Farm Wins started")

    task.spawn(function()
        local success, reason = pcall(function()
            for index, stageNumber in ipairs(WIN_STAGE_ORDER) do
                if closed or token ~= winsLoopToken or mode ~= "wins" then
                    return
                end

                winsStageIndex = index

                local destination = WIN_STAGES[stageNumber]
                local currentCharacter, currentRoot = getCharacter()
                if not currentCharacter or not currentRoot then
                    error("Character unavailable during Auto Farm Wins")
                end

                status.Text = string.format(
                    "AUTO FARM WINS • Stage %d/90\nMoving to stage...",
                    stageNumber
                )

                -- Keep the fast direct movement that worked in the original V17.
                -- No PathfindingService and no slow waypoint interpolation.
                moveCharacter(currentCharacter, currentRoot, destination)
                task.wait(WIN_STAGE_SETTLE)

                local cleared, clearReason = waitForStageClear(
                    token,
                    stageNumber,
                    destination
                )

                if not cleared then
                    status.Text = string.format(
                        "Stage %d timed out • stopping Auto Farm Wins.",
                        stageNumber
                    )
                    return
                end
            end

            if closed or token ~= winsLoopToken or mode ~= "wins" then
                return
            end

            winsCollecting = true
            status.Text =
                "AUTO FARM WINS • Stage 90 cleared\nCollecting FREE Wins..."

            local currentCharacter, currentRoot = getCharacter()
            if not currentCharacter or not currentRoot then
                error("Character unavailable before win collection")
            end

            -- FREE Wins pad only.
            moveCharacter(currentCharacter, currentRoot, WIN_START)
            task.wait(1.25)
            winsCollecting = false
            showNotification("Free wins collected")
        end)

        winsCollecting = false

        if not success
            and token == winsLoopToken
            and mode == "wins"
            and not closed then

            status.Text = "Auto Farm Wins paused • Check the game state."
            warn("Auto Farm Wins:", reason)
        end

        if token == winsLoopToken
            and mode == "wins"
            and not closed
            and desiredMode == "wins"
            and farmForever then

            task.wait(0.75)

            if token == winsLoopToken and mode == "wins" then
                startWins(true)
            end
        end
    end)
end

