local function getGuiTextObjects(root)
    local results = {}
    if not root then return results end

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local txt = obj.Text
            if type(txt) == "string" and txt ~= "" and isShown(obj) then
                table.insert(results, obj)
            end
        end
    end

    return results
end

local function hasKeywordInAncestors(obj, keywords)
    local cursor = obj
    for _ = 1, 8 do
        if not cursor then break end
        local name = string.lower(cursor.Name or "")
        local textValue = ""
        if cursor:IsA("TextLabel") or cursor:IsA("TextButton") or cursor:IsA("TextBox") then
            textValue = string.lower(cursor.Text or "")
        end

        for _, keyword in ipairs(keywords) do
            local k = string.lower(keyword)
            if string.find(name, k, 1, true) or string.find(textValue, k, 1, true) then
                return true
            end
        end

        cursor = cursor.Parent
    end
    return false
end

local function findDisplayedStat(keywords, mode)
    -- First preference: an actual numeric Value/Attribute with a descriptive name.
    local roots = {player:FindFirstChild("leaderstats"), player}
    for _, rootObj in ipairs(roots) do
        if rootObj then
            for _, obj in ipairs(rootObj:GetDescendants()) do
                if (obj:IsA("IntValue") or obj:IsA("NumberValue")) then
                    local name = string.lower(obj.Name)
                    for _, k in ipairs(keywords) do
                        if string.find(name, string.lower(k), 1, true) then
                            return obj.Value, tostring(obj.Value)
                        end
                    end
                end
            end
        end
    end

    -- Second preference: player attributes.
    local attributes = player:GetAttributes()
    for name, value in pairs(attributes) do
        if type(value) == "number" or type(value) == "string" then
            local lowerName = string.lower(name)
            for _, k in ipairs(keywords) do
                if string.find(lowerName, string.lower(k), 1, true) then
                    local numeric = type(value) == "number" and value or parseDisplayedNumber(value)
                    return numeric, tostring(value)
                end
            end
        end
    end

    -- Third preference: the visible HUD. This game exposes Strength/Rebirth as text,
    -- so search GUI objects and use their hierarchy/labels rather than only Values.
    local guiObjects = getGuiTextObjects(playerGui)
    local bestNumeric, bestText, bestScore = nil, nil, -math.huge

    for _, obj in ipairs(guiObjects) do
        local txt = obj.Text
        local parsed = parseDisplayedNumber(txt)
        if parsed ~= nil then
            local score = 0
            if hasKeywordInAncestors(obj, keywords) then
                score += 100
            end

            local lowerText = string.lower(txt)
            if mode == "percent" and string.find(lowerText, "%%") then
                score += 75 + math.min(100, parsed)
            elseif mode ~= "percent" then
                if string.find(lowerText, "%a") then score += 10 end
                if string.find(lowerText, "x", 1, true) then score -= 20 end
                if string.find(lowerText, "/", 1, true) then score -= 15 end
            end

            -- For this game's HUD, the main strength value is a very large abbreviated number.
            if mode == "strength" then
                if string.find(txt, "DDe", 1, true) then score += 90 end
                if string.find(txt, "UDe", 1, true) then score += 80 end
                if string.find(txt, "TDe", 1, true) then score += 70 end
                score += math.min(25, math.log10(math.max(parsed, 1)))
            end

            if score > bestScore then
                bestScore = score
                bestNumeric = parsed
                bestText = txt
            end
        end
    end

    return bestNumeric, bestText
end

