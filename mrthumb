    if success then
        local deadline = os.clock() + 3

        while not closed
            and readRebirthState() ~= desired
            and os.clock() < deadline do
            task.wait(0.1)
        end

        if closed then
            return
        end

        local confirmedState = readRebirthState() == desired
        if confirmedState and mode == "bag" then
            autoRebirthEnsured = desired == true
        end

        rebirthHint.Text = confirmedState
            and "Game toggle updated. The game handles eligibility."
            or "Change wasn't confirmed. No repeat click was sent."
    else
        rebirthHint.Text = "Couldn't change the setting. Check the console."
        warn("Auto Rebirth:", reason)
    end

    rebirthBusy = false
    refreshRebirthButton()
end)

