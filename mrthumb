connect(rebirthButton.Activated, function()
    if rebirthBusy or clickBusy then
        return
    end

    if mode == "coop" and not align then
        rebirthHint.Text = "Wait until the co-op joining sequence finishes."
        return
    end

    local current = readRebirthState()
    if current == nil then
        rebirthHint.Text = "Train at a bag and wait for its toggle to appear."
        return
    end

    local desired = not current
    rebirthBusy = true
    refreshRebirthButton()

    local success, reason = withPanelHidden(function()
        local latest = readRebirthState()

        if latest == nil then
            error("Auto Rebirth state is unavailable.")
        end

        -- Don't click if the game already reached the requested state.
        if latest ~= desired then
            sendClick(getRebirthButton())
        end
    end)

    if closed then
        return
    end

    if success then
        local deadline = os.clock() + 3

        while not closed
            and readRebirthState() ~= desired
            and os.clock() < deadline do
            task.wait(0.1)
        end

        if closed then
            return
        end

        rebirthHint.Text = readRebirthState() == desired
            and "Game toggle updated. The game handles eligibility."
            or "Change wasn't confirmed. No repeat click was sent."
    else
        rebirthHint.Text = "Couldn't change the setting. Check the console."
        warn("Auto Rebirth:", reason)
    end

    rebirthBusy = false
    refreshRebirthButton()
end)

