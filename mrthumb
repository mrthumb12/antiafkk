    return container, container and container:FindFirstChild("Toggle")
end

local function colourMatches(actual, expected)
    return math.abs(actual.R - expected.R) < 0.02
        and math.abs(actual.G - expected.G) < 0.02
        and math.abs(actual.B - expected.B) < 0.02
end

local function readRebirthState()
    local _, indicator = getRebirthControl()

    if not indicator or not indicator:IsA("GuiObject") then
        return nil
    end

    local colour = indicator.BackgroundColor3

    if colourMatches(colour, Color3.fromRGB(102, 255, 0)) then
        return true
    elseif colourMatches(colour, Color3.fromRGB(255, 50, 0)) then
        return false
    end

    return nil
end

local function getRebirthButton()
    local container = getRebirthControl()

    if not container or not isShown(container) then
        error("Auto Rebirth control is not visible.")
    end

    if container:IsA("GuiButton") then
        return container
    end

    local candidates = {}
    for _, object in ipairs(container:GetDescendants()) do
        if object:IsA("GuiButton") and isShown(object) then
            table.insert(candidates, object)
        end
    end

    if #candidates == 0 then
        error("No clickable GuiButton found inside " .. container:GetFullName())
    end

    for _, object in ipairs(candidates) do
        if object.Name == "Toggle" or object.Name == "AutoRebirthBtn" then
            return object
        end
    end

    return candidates[1]
end

local function sendClick(target)
    if not target or not isShown(target) then
        error("The Auto Rebirth target is not visible.")
    end

    if not target:IsA("GuiButton") then
        error("Auto Rebirth target is not a GuiButton: " .. target:GetFullName())
    end

    -- IMPORTANT: only perform ONE activation attempt.
    -- Firing both Activated and MouseButton1Click can toggle the same switch twice.
    local activated = pcall(function()
        target:Activate()
    end)

    if activated then
        task.wait(0.25)
        if readRebirthState() == true then
            return true
        end
    end

    -- Executor fallback: choose exactly one signal, not both.
    -- This avoids an ON->OFF double toggle when the game has handlers on both events.
    if typeof(getconnections) == "function" and typeof(firesignal) == "function" then
        local signal = target.Activated
        local okConnections, connections = pcall(getconnections, signal)

        if okConnections and type(connections) == "table" and #connections > 0 then
            pcall(function()
                firesignal(signal)
            end)

            task.wait(0.25)

            if readRebirthState() == true then
                return true
            end
        end
    end

    return false
end
-- Shared click lock: hide only this helper while clicking game UI.
local function withPanelHidden(action)
    if clickBusy or closed then
        return false, "Another UI action is busy."
    end

    clickBusy = true
    local wasEnabled = gui.Enabled
    gui.Enabled = false

    local success, reason = pcall(function()
        task.wait(0.1)

        if not closed then
            action()
        end

        task.wait(0.1)
    end)

    if not closed and gui.Parent then
        gui.Enabled = wasEnabled
    end

    clickBusy = false
    return success, reason
end

local function refreshRebirthButton()
    if rebirthBusy then
        rebirthButton.Text = "AUTO REBIRTH: CHANGING..."
        return
    end

    local state = readRebirthState()

    if state == nil then
        rebirthButton.Text = "AUTO REBIRTH: WAITING..."
        rebirthButton.BackgroundColor3 = Color3.fromRGB(70, 72, 94)
    else
        rebirthButton.Text = state
            and "AUTO REBIRTH: ON"
            or "AUTO REBIRTH: OFF"

        rebirthButton.BackgroundColor3 = state
            and Color3.fromRGB(52, 91, 111)
            or Color3.fromRGB(112, 78, 183)
    end
end

-- Automatically enable the game's Auto Rebirth setting.
-- This only clicks when the game clearly reports that it is OFF.
local function ensureRebirthOn()
    if closed or mode ~= "bag" or rebirthBusy or clickBusy then
        return false
    end

    -- Only verify/click once per Hacker Bag session or recovery.
    if autoRebirthEnsured then
        return true
    end

    local current = readRebirthState()

    if current == nil then
        return false
    end

    if current == true then
        refreshRebirthButton()
        return true
    end

    rebirthBusy = true
    refreshRebirthButton()

    local success, reason = withPanelHidden(function()
        local latest = readRebirthState()

        if latest == nil then
            error("Auto Rebirth state is unavailable.")
        end

        if latest == false then
            -- The game's toggle can update its visual state slightly after
            -- the activation signal fires, so do not treat an immediate
            -- false read as a callback failure. The confirmation check
            -- below is the authoritative result.
            sendClick(getRebirthButton())
        end
    end)

    if closed then
        return false
    end

    if success then
        local deadline = os.clock() + 3

        while not closed
            and readRebirthState() ~= true
            and os.clock() < deadline do
            task.wait(0.1)
        end

        local enabled = readRebirthState() == true

        if enabled then
            autoRebirthEnsured = true
            lastAction = "Auto Rebirth enabled"
            showNotification("Auto Rebirth enabled")
        end
        updateLiveMonitor()

        rebirthHint.Text = enabled
            and "Auto Rebirth automatically enabled."
            or "Auto Rebirth click wasn't confirmed."

        rebirthBusy = false
        refreshRebirthButton()
        return enabled
    end

    rebirthBusy = false
    refreshRebirthButton()
    rebirthHint.Text = "Auto Rebirth activation failed."
    warn("Auto Rebirth:", reason)
    return false
end

local function waitFor(token, character, timeout, predicate)
    local deadline = os.clock() + timeout

    repeat
        if not isCurrent(token, character) then
            return false
        end

        if predicate() then
            return true
        end

        task.wait(0.1)
    until os.clock() >= deadline

    return false
end

local function moveCharacter(character, root, destination)
    local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo(destination * rootToPivot)
end

local function enableHover(root)
    baseline = root.Position.Y
    heldRoot = root

    attachment = Instance.new("Attachment")
    attachment.Name = "MrThumbHoverAttachment"
    attachment.Parent = root

    align = Instance.new("AlignPosition")
    align.Name = "MrThumbHover"
    align.Mode = Enum.PositionAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.ApplyAtCenterOfMass = true
    align.RigidityEnabled = false
    align.ForceLimitMode = Enum.ForceLimitMode.PerAxis

    align.MaxAxesForce = Vector3.new(
        0,
        root.AssemblyMass * math.max(workspace.Gravity, 1) * 4,
        0
    )

    align.MaxVelocity = 20
    align.Responsiveness = 20
    align.Position = root.Position + Vector3.new(0, hoverHeight, 0)
    align.Parent = root
end

local function startCoop(isRecovery)
    if clickBusy or rebirthBusy then
        status.Text = "Wait for the current UI action to finish."
        return
    end

    local character, root = getCharacter()
    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    local token = begin("coop", character, isRecovery == true)

    task.spawn(function()
        local success, reason = pcall(function()
            if not isCurrent(token, character) then
                return
            end

            status.Text = "1/3 • Moving to the portal approach."
            moveCharacter(character, root, PORTAL)

            status.Text =
                "1/3 • Waiting for Start.\nWalk into the portal if needed."

            local ready = waitFor(token, character, 25, function()
                return findStartButton() ~= nil
            end)

            if not isCurrent(token, character) then
                return
            end

            if not ready then
                stopFarm("Stopped • Start menu wasn't detected.")
                return
            end

            status.Text = "2/3 • Clicking Start once."

            local clicked, clickError = withPanelHidden(function()
                if isCurrent(token, character) then
                    sendClick(findStartButton())
                end
            end)

            if not isCurrent(token, character) then
                return
            end

            if not clicked then
                error(tostring(clickError))
            end

            status.Text = "2/3 • Waiting for arena arrival."

            local arrived = waitFor(token, character, 30, function()
                local currentCharacter, currentRoot = getCharacter()

                return currentCharacter == character
                    and currentRoot ~= nil
                    and (currentRoot.Position - ARENA).Magnitude <= 100
                    and findStartButton() == nil
            end)

            if not isCurrent(token, character) then
                return
            end

            if not arrived then
                stopFarm("Stopped • Arena arrival wasn't confirmed.")
                return
            end

            local _, currentRoot = getCharacter()
            if not currentRoot then
                stopFarm("Stopped • Character unavailable.")
                return
            end

            enableHover(currentRoot)
            status.Text = "3/3 • Hover enabled. Co-op Farm active."
        end)

        if not success and isCurrent(token, character) then
            stopFarm("Stopped • Co-op action failed. Check the console.")
            warn("Co-op Farm:", reason)
        end
    end)
end

local function startBag(isRecovery)
    if clickBusy or rebirthBusy then
        status.Text = "Wait for the current UI action to finish."
        return
    end

    local character, root = getCharacter()
    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    begin("bag", character, isRecovery == true)
    lastAction = isRecovery and "Bag recovery" or "Bag started"
    if isRecovery then totalRecoveries += 1 end
    updateLiveMonitor()
    showNotification(isRecovery and "Hacker Bag recovery" or "Hacker Bag farming started")

    local success, reason = pcall(function()
        moveCharacter(character, root, HACKER_BAG)
    end)

    if not success then
        stopFarm("Stopped • Hacker Bag movement failed.")
        warn("Hacker Bag:", reason)
        return
    end

    status.Text =
        "HACKER BAG ON • AFK handling enabled.\nEnabling Auto Rebirth..."

    local token = generation

    task.spawn(function()
        -- Give the game's UI time to settle after teleporting to the bag.
        task.wait(0.8)

        if closed or mode ~= "bag" or token ~= generation then
            return
        end

        if ensureRebirthOn() then
            status.Text = "HACKER BAG ON • Auto Rebirth ON.\nAFK farming active."
        else
            status.Text = "HACKER BAG ON • Auto Rebirth not confirmed."
        end
    end)
end

