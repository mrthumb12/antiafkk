local function getCharacter()
    local character = player.Character
    if not character then
        return nil, nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not root:IsA("BasePart")
        or not humanoid or humanoid.Health <= 0 then
        return nil, nil
    end

    return character, root
end

local function clearHover()
    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    heldRoot = nil
end

local function updateButtons()
    coopButton.Text = mode == "coop"
        and "CO-OP FARM: ON — CLICK TO STOP"
        or "CO-OP FARM: OFF"

    bagButton.Text = mode == "bag"
        and "AUTO FARM: HACKER BAG — ON"
        or "AUTO FARM: HACKER BAG — OFF"

    coopButton.BackgroundColor3 = mode == "coop"
        and Color3.fromRGB(52, 91, 111)
        or Color3.fromRGB(112, 78, 183)

    bagButton.BackgroundColor3 = mode == "bag"
        and Color3.fromRGB(52, 91, 111)
        or Color3.fromRGB(112, 78, 183)
end

local function stop(message)
    generation += 1
    mode = nil
    activeCharacter = nil
    clearHover()
    updateButtons()

    status.Text = message
        or "OFF • Helper stopped. Existing game training may continue."
end

local function begin(selectedMode, character)
    stop()
    mode = selectedMode
    activeCharacter = character
    elapsed = 0
    attempts = 0
    counter.Text = "Idle input attempts: 0"
    updateButtons()
    return generation
end

local function isCurrent(token, character)
    return mode ~= nil
        and generation == token
        and gui.Parent ~= nil
        and player.Character == character
end

local function moveCharacter(character, root, destination)
    local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo(destination * rootToPivot)
end

local function findStartButton()
    local object = playerGui

    for _, name in ipairs({
        "ScreenGui", "Menus", "EndlessJoin",
        "Container", "Main", "Join", "TextLabel",
    }) do
        object = object:FindFirstChild(name)
        if not object then
            return nil
        end
    end

    if not object:IsA("TextLabel") or object.Text ~= "Start" then
        return nil
    end

    local label = object

    while object and object ~= playerGui do
        if object:IsA("GuiObject") and not object.Visible then
            return nil
        end

        if object:IsA("ScreenGui") and not object.Enabled then
            return nil
        end

        object = object.Parent
    end

    local target = label:FindFirstAncestorWhichIsA("GuiButton")

    if target and target.AbsoluteSize.X > 0
        and target.AbsoluteSize.Y > 0 then
        return target
    end

    return nil
end

local function clickStart(token, character)
    local wasEnabled = gui.Enabled

    -- Hide our own panel so it cannot intercept the click.
    gui.Enabled = false

    local success, reason = pcall(function()
        task.wait(0.1)

        if not isCurrent(token, character) then
            return
        end

        local target = findStartButton()
        if not target then
            error("Start menu disappeared before clicking.")
        end

        local position = target.AbsolutePosition
        local size = target.AbsoluteSize
        local screen = target:FindFirstAncestorWhichIsA("ScreenGui")
        local inset = Vector2.zero

        if screen and not screen.IgnoreGuiInset then
            inset = GuiService:GetGuiInset()
        end

        local x = position.X + size.X / 2 + inset.X
        local y = position.Y + size.Y / 2 + inset.Y
        local input = game:GetService("VirtualInputManager")

        input:SendMouseButtonEvent(x, y, 0, true, game, 0)
        input:SendMouseButtonEvent(x, y, 0, false, game, 0)

        task.wait(0.1)
    end)

    -- Restore the panel even if the input call failed.
    if gui.Parent then
        gui.Enabled = wasEnabled
    end

    if not success then
        error(tostring(reason), 0)
    end
end

local function waitFor(token, character, timeout, predicate)
    local deadline = os.clock() + timeout

    repeat
        if not isCurrent(token, character) then
            return false
        end

        if predicate() then
            return true
        end

        task.wait(0.1)
    until os.clock() >= deadline

    return false
end

local function enableHover(root)
    baseline = root.Position.Y
    heldRoot = root

    attachment = Instance.new("Attachment")
    attachment.Name = "MrThumbHoverAttachment"
    attachment.Parent = root

    align = Instance.new("AlignPosition")
    align.Name = "MrThumbHover"
    align.Mode = Enum.PositionAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.ApplyAtCenterOfMass = true
    align.RigidityEnabled = false
    align.ForceLimitMode = Enum.ForceLimitMode.PerAxis

    -- Vertical force only.
    align.MaxAxesForce = Vector3.new(
        0,
        root.AssemblyMass * math.max(workspace.Gravity, 1) * 4,
        0
    )

    align.MaxVelocity = 20
    align.Responsiveness = 20
    align.Position = root.Position + Vector3.new(0, hoverHeight, 0)
    align.Parent = root
end

local function startCoop()
    local character, root = getCharacter()

    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    local token = begin("coop", character)

    task.spawn(function()
        local success, reason = pcall(function()
            if not isCurrent(token, character) then
                return
            end

            status.Text = "1/3 • Moving to the portal approach."
            moveCharacter(character, root, PORTAL)

            status.Text =
                "1/3 • Waiting for Start.\nWalk into the portal if needed."

            local menuReady = waitFor(token, character, 25, function()
                return findStartButton() ~= nil
            end)

            if not isCurrent(token, character) then
                return
            end

            if not menuReady then
                stop("Stopped • Start menu wasn't detected.")
                return
            end

            status.Text = "2/3 • Clicking Start once."
            clickStart(token, character)

            if not isCurrent(token, character) then
                return
            end

            status.Text = "2/3 • Waiting for arena arrival."

            local arrived = waitFor(token, character, 30, function()
                local currentCharacter, currentRoot = getCharacter()
                return currentCharacter == character
                    and currentRoot ~= nil
                    and (currentRoot.Position - ARENA).Magnitude <= 100
                    and findStartButton() == nil
            end)

            if not isCurrent(token, character) then
                return
            end

            if not arrived then
                stop("Stopped • Arena arrival wasn't confirmed.")
                return
            end

            local _, currentRoot = getCharacter()

            if not currentRoot then
                stop("Stopped • Character unavailable.")
                return
            end

            enableHover(currentRoot)
            status.Text = "3/3 • Hover enabled. Verify auto-fight is working."
        end)

        if not success and isCurrent(token, character) then
            stop("Stopped • Co-op action failed. Check the console.")
            warn("Co-op Farm:", reason)
        end
    end)
end

local function startBag()
    local character, root = getCharacter()

    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    begin("bag", character)

    local success, reason = pcall(function()
        moveCharacter(character, root, HACKER_BAG)
    end)

    if not success then
        stop("Stopped • Hacker Bag movement failed.")
        warn("Hacker Bag:", reason)
        return
    end

    status.Text =
        "HACKER BAG ON • AFK handling enabled.\nCheck that strength increases."
end

