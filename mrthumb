local SUFFIX_MULTIPLIERS = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    QA = 1e15,
    QI = 1e18,
    SX = 1e21,
    SP = 1e24,
    OC = 1e27,
    NO = 1e30,
    DC = 1e33,
    UDE = 1e36,
    DDE = 1e39,
    TDE = 1e42,
    QADE = 1e45,
    QIDE = 1e48,
    SXDE = 1e51,
    SPDE = 1e54,
    OCDE = 1e57,
    NODE = 1e60,
    VGE = 1e63,
}

local function formatNumber(v)
    if type(v) ~= "number" then return "unavailable" end
    local av = math.abs(v)
    if av >= 1e63 then return string.format("%.2fVgE", v / 1e63) end
    if av >= 1e60 then return string.format("%.2fNoDe", v / 1e60) end
    if av >= 1e57 then return string.format("%.2fOcDe", v / 1e57) end
    if av >= 1e54 then return string.format("%.2fSpDe", v / 1e54) end
    if av >= 1e51 then return string.format("%.2fSxDe", v / 1e51) end
    if av >= 1e48 then return string.format("%.2fQiDe", v / 1e48) end
    if av >= 1e45 then return string.format("%.2fQaDe", v / 1e45) end
    if av >= 1e42 then return string.format("%.2fTDe", v / 1e42) end
    if av >= 1e39 then return string.format("%.2fDDe", v / 1e39) end
    if av >= 1e36 then return string.format("%.2fUDe", v / 1e36) end
    if av >= 1e33 then return string.format("%.2fDc", v / 1e33) end
    if av >= 1e30 then return string.format("%.2fNo", v / 1e30) end
    if av >= 1e27 then return string.format("%.2fOc", v / 1e27) end
    if av >= 1e24 then return string.format("%.2fSp", v / 1e24) end
    if av >= 1e21 then return string.format("%.2fSx", v / 1e21) end
    if av >= 1e18 then return string.format("%.2fQi", v / 1e18) end
    if av >= 1e15 then return string.format("%.2fQa", v / 1e15) end
    if av >= 1e12 then return string.format("%.2fT", v / 1e12) end
    if av >= 1e9 then return string.format("%.2fB", v / 1e9) end
    if av >= 1e6 then return string.format("%.2fM", v / 1e6) end
    if av >= 1e3 then return string.format("%.2fK", v / 1e3) end
    return string.format("%.0f", v)
end

local function parseDisplayedNumber(textValue)
    if type(textValue) ~= "string" then return nil end

    local cleaned = textValue
        :gsub(",", "")
        :gsub("%s+", "")

    local numberText, suffix = string.match(cleaned, "([%+%-]?%d+%.?%d*)[xX]?[ ]*([%a]+)")
    if numberText then
        local base = tonumber(numberText)
        if base then
            local key = string.upper(suffix)
            local mult = SUFFIX_MULTIPLIERS[key]
            if mult then return base * mult end
        end
    end

    local plain = string.match(cleaned, "[%+%-]?%d+%.?%d*")
    return plain and tonumber(plain) or nil
end

