local WIN_ENEMY_RADIUS = 75
local WIN_ENEMY_SPAWN_WAIT = 4.0
local WIN_CLEAR_CONFIRM = 0.5
local WIN_STAGE_SETTLE = 0.12
local WIN_STAGE_TIMEOUT = 45

local function getEnemyPosition(model)
    local rootPart = model:FindFirstChild("HumanoidRootPart")
    if rootPart and rootPart:IsA("BasePart") then
        return rootPart.Position
    end

    if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
        return model.PrimaryPart.Position
    end

    local ok, pivot = pcall(function()
        return model:GetPivot()
    end)

    if ok and pivot then
        return pivot.Position
    end

    return nil
end

local function isPlayerCharacter(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then
            return true
        end
    end
    return false
end

-- Actual combat enemies observed in the game carry EnemyId and a Humanoid.
-- Lobby showcase characters and player characters are intentionally ignored.
local function isLiveCombatEnemy(model)
    if not model or not model:IsA("Model") then
        return false
    end

    if isPlayerCharacter(model) then
        return false
    end

    if model:GetAttribute("EnemyId") == nil then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0.1 then
        return false
    end

    if model:GetAttribute("Ragdolled") == true then
        return false
    end

    return true
end

local function countStageEnemies(stagePosition, radius)
    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isLiveCombatEnemy(obj) then
            local position = getEnemyPosition(obj)
            if position and (position - stagePosition).Magnitude <= radius then
                count += 1
            end
        end
    end

    return count
end

local function waitForStageClear(token, targetStage, targetCFrame)
    local stagePosition = targetCFrame.Position
    local deadline = os.clock() + WIN_STAGE_TIMEOUT
    local spawnDeadline = os.clock() + WIN_ENEMY_SPAWN_WAIT
    local sawEnemy = false
    local clearSince = nil

    while not closed
        and token == winsLoopToken
        and mode == "wins"
        and os.clock() < deadline do

        local character, root = getCharacter()
        if not character or not root then
            return false, "character unavailable"
        end

        local nearby = countStageEnemies(stagePosition, WIN_ENEMY_RADIUS)

        if nearby > 0 then
            sawEnemy = true
            clearSince = nil
        elseif sawEnemy then
            clearSince = clearSince or os.clock()

            if os.clock() - clearSince >= WIN_CLEAR_CONFIRM then
                winsHighestStage = math.max(winsHighestStage, targetStage)
                return true, "cleared"
            end
        elseif os.clock() >= spawnDeadline then
            -- Some stages may already be cleared or may not create a new local
            -- enemy immediately. Do not freeze the entire farm on that case.
            winsHighestStage = math.max(winsHighestStage, targetStage)
            return true, "no enemy observed"
        end

        winsInfo.Text = string.format(
            "Stage %d  •  Enemies: %d  •  Highest: %d",
            targetStage,
            nearby,
            winsHighestStage
        )

        task.wait(0.20)
    end

    return false, "stage timeout"
end

