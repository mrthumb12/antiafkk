connect(player.Idled, function()
    -- Avoid interfering with an in-progress UI click.
    if not mode or clickBusy or rebirthBusy then
        return
    end

    local token = generation
    attempts += 1
    counter.Text = "Idle input attempts: " .. attempts

    local success, reason = pcall(function()
        local camera = workspace.CurrentCamera
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(
            Vector2.new(0, 0),
            camera and camera.CFrame or CFrame.new()
        )
    end)

    if not success and token == generation and not closed then
        stopFarm("Stopped • Idle input unavailable in this environment.")
        warn("AFK input:", reason)
    end
end)

local refresh = 0
local autoRebirthCheck = 0

connect(RunService.Heartbeat, function(delta)
    if mode then
        elapsed += delta

        local character, root = getCharacter()

        if character ~= activeCharacter or not root then
            stopFarm("Stopped • Character changed or died.")
        elseif mode == "bag" then
            if (root.Position - HACKER_BAG.Position).Magnitude > 50 then
                stopFarm("Stopped • You left the Hacker Bag area.")
            end
        elseif align then
            if root ~= heldRoot or not align.Parent then
                stopFarm("Stopped • Hover constraint changed.")
            elseif (root.Position - ARENA).Magnitude > 250 then
                stopFarm("Stopped • You moved away from the recorded arena.")
            else
                align.Position = Vector3.new(
                    root.Position.X,
                    baseline + hoverHeight,
                    root.Position.Z
                )
            end
        end
    end

    refresh += delta
    autoRebirthCheck += delta

    if autoRebirthCheck >= 1 then
        autoRebirthCheck = 0

        -- Auto Rebirth is ONLY managed automatically by Hacker Bag.
        -- Co-op Farm will never open/click the game's Auto Rebirth control.
        if mode == "bag" and not rebirthBusy and not clickBusy then
            task.spawn(function()
                ensureRebirthOn()
            end)
        end
    end

    if refresh < 0.25 then
        return
    end
    refresh = 0

    local seconds = math.floor(elapsed)

    timer.Text = string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60,
        seconds % 60
    )

    refreshRebirthButton()

    if mode == "coop" and align and heldRoot then
        status.Text = string.format(
            "CO-OP FARM ON • Target +%d studs\nObserved height: %+.1f • Combat unverified.",
            hoverHeight,
            heldRoot.Position.Y - baseline
        )
    end
end)

