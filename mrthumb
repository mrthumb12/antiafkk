local function getCharacter()
    local character = player.Character
    if not character then
        return nil, nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then
        return nil, nil
    end

    return character, root
end

local function clearHover()
    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    heldRoot = nil
end

local function stopFarm(message)
    generation += 1
    running = false
    clearHover()

    farmButton.Text = "CO-OP FARM: OFF"
    farmButton.BackgroundColor3 = Color3.fromRGB(112, 78, 183)
    status.Text = message or "OFF • Pending actions cancelled. Gravity restored."
end

local function stillRunning(token, character)
    return running
        and token == generation
        and gui.Parent ~= nil
        and player.Character == character
end

local function findStartButton()
    local object = playerGui

    for _, name in ipairs({
        "ScreenGui",
        "Menus",
        "EndlessJoin",
        "Container",
        "Main",
        "Join",
        "TextLabel",
    }) do
        object = object:FindFirstChild(name)
        if not object then
            return nil
        end
    end

    if not object:IsA("TextLabel") or object.Text ~= "Start" then
        return nil
    end

    local label = object

    while object and object ~= playerGui do
        if object:IsA("GuiObject") and not object.Visible then
            return nil
        end

        if object:IsA("ScreenGui") and not object.Enabled then
            return nil
        end

        object = object.Parent
    end

    local target = label:FindFirstAncestorWhichIsA("GuiButton")

    if target and target.AbsoluteSize.X > 0 and target.AbsoluteSize.Y > 0 then
        return target
    end

    return nil
end

local function clickStart(target)
    local position = target.AbsolutePosition
    local size = target.AbsoluteSize
    local screen = target:FindFirstAncestorWhichIsA("ScreenGui")
    local inset = Vector2.zero

    if screen and not screen.IgnoreGuiInset then
        inset = GuiService:GetGuiInset()
    end

    local x = position.X + size.X / 2 + inset.X
    local y = position.Y + size.Y / 2 + inset.Y

    local input = game:GetService("VirtualInputManager")
    input:SendMouseButtonEvent(x, y, 0, true, game, 0)
    input:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function waitFor(token, character, timeout, predicate)
    local deadline = os.clock() + timeout

    repeat
        if not stillRunning(token, character) then
            return false
        end

        if predicate() then
            return true
        end

        task.wait(0.1)
    until os.clock() >= deadline

    return false
end

local function enableHover(root)
    baseline = root.Position.Y
    heldRoot = root

    attachment = Instance.new("Attachment")
    attachment.Name = "CoopFarmAttachment"
    attachment.Parent = root

    align = Instance.new("AlignPosition")
    align.Name = "CoopFarmHover"
    align.Mode = Enum.PositionAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.ApplyAtCenterOfMass = true
    align.RigidityEnabled = false
    align.ForceLimitMode = Enum.ForceLimitMode.PerAxis

    -- Vertical force only; horizontal movement remains free.
    align.MaxAxesForce = Vector3.new(
        0,
        root.AssemblyMass * math.max(workspace.Gravity, 1) * 4,
        0
    )

    align.MaxVelocity = 20
    align.Responsiveness = 20
    align.Position = root.Position + Vector3.new(0, height, 0)
    align.Parent = root
end

local function startFarm()
    local character, root = getCharacter()

    if not character then
        status.Text = "Wait for your character to finish spawning."
        return
    end

    clearHover()
    generation += 1

    local token = generation
    running = true
    elapsed = 0

    farmButton.Text = "CO-OP FARM: ON — CLICK TO STOP"
    farmButton.BackgroundColor3 = Color3.fromRGB(52, 91, 111)

    task.spawn(function()
        local success, reason = pcall(function()
            status.Text = "1/3 • Moving to the portal approach."

            local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
            character:PivotTo(PORTAL * rootToPivot)

            status.Text = "1/3 • Waiting for Start. Walk into the portal if needed."

            local foundMenu = waitFor(
                token,
                character,
                MENU_TIMEOUT,
                function()
                    return findStartButton() ~= nil
                end
            )

            if not stillRunning(token, character) then
                return
            end

            if not foundMenu then
                stopFarm("Stopped • Start menu wasn't detected. Try again near the portal.")
                return
            end

            local target = findStartButton()
            if not target then
                stopFarm("Stopped • Start menu disappeared before clicking.")
                return
            end

            status.Text = "2/3 • Clicking Start once. Waiting for arena arrival."
            clickStart(target)

            local arrived = waitFor(
                token,
                character,
                ARRIVAL_TIMEOUT,
                function()
                    local currentCharacter, currentRoot = getCharacter()
                    return currentCharacter == character
                        and currentRoot ~= nil
                        and (currentRoot.Position - ARENA).Magnitude <= ARRIVAL_RADIUS
                        and findStartButton() == nil
                end
            )

            if not stillRunning(token, character) then
                return
            end

            if not arrived then
                stopFarm("Stopped • Arena arrival wasn't confirmed. Hover wasn't enabled.")
                return
            end

            local _, currentRoot = getCharacter()
            if not currentRoot then
                stopFarm("Stopped • Character unavailable.")
                return
            end

            enableHover(currentRoot)
            status.Text = "3/3 • Hover enabled. Check that auto-fight continues."
        end)

        if not success and stillRunning(token, character) then
            stopFarm("Stopped • An action failed. Check the console.")
            warn("Co-op Farm:", reason)
        end
    end)
end

connect(farmButton.Activated, function()
    if running then
        stopFarm()
    else
        startFarm()
    end
end)

local function changeHeight(amount)
    height = math.clamp(height + amount, 2, 30)
    heightLabel.Text = "Hover: " .. height .. " studs"
end

connect(minus.Activated, function()
    changeHeight(-2)
end)

connect(plus.Activated, function()
    changeHeight(2)
end)

local refresh = 0

connect(RunService.Heartbeat, function(delta)
    if running then
        elapsed += delta

        local _, root = getCharacter()
        if not root then
            stopFarm("Stopped • Character unavailable.")
        elseif align then
            if root ~= heldRoot or not align.Parent then
                stopFarm("Stopped • Character or hover constraint changed.")
            else
                align.Position = Vector3.new(
                    root.Position.X,
                    baseline + height,
                    root.Position.Z
                )
            end
        end
    end

    refresh += delta
    if refresh < 0.25 then
        return
    end
    refresh = 0

    local seconds = math.floor(elapsed)
    timer.Text = string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60,
        seconds % 60
    )

    if running and align and heldRoot then
        status.Text = string.format(
            "CO-OP FARM ON • Target +%d studs\nObserved height: %+.1f • Combat not verified",
            height,
            heldRoot.Position.Y - baseline
        )
    end
end)

