local function updateObservedStats()
    local rebirthValue, rebirthDisplay = findDisplayedStat({"rebirth"}, "percent")
    if rebirthValue ~= nil then
        -- Ignore percentage progress as a rebirth count; it is still useful to show in the HUD.
        if rebirthDisplay and string.find(rebirthDisplay, "%%") then
            lastRebirthDisplay = rebirthDisplay
        elseif lastObservedRebirth ~= nil and rebirthValue > lastObservedRebirth then
            sessionRebirths += rebirthValue - lastObservedRebirth
        end
        if not (rebirthDisplay and string.find(rebirthDisplay, "%%")) then
            lastObservedRebirth = rebirthValue
        end
    end

    local strengthValue, strengthDisplay = findDisplayedStat({"strength", "power"}, "strength")
    if strengthValue ~= nil then
        lastGainValue = strengthValue
        lastStrengthDisplay = strengthDisplay or formatNumber(strengthValue)

        if gainStartValue == nil then
            gainStartValue = strengthValue
            lastTrackedStrength = strengthValue
            sessionGain = 0
        else
            local previous = lastTrackedStrength or gainStartValue
            if strengthValue >= previous then
                sessionGain = (sessionGain or 0) + (strengthValue - previous)
            end
            lastTrackedStrength = strengthValue
        end
    end
end

local function updateLiveMonitor()
    updateObservedStats()
    local farmName = mode == "bag" and "HACKER BAG" or mode == "coop" and "CO-OP" or "IDLE"
    local hours = math.max((os.clock() - sessionStart) / 3600, 1/3600)
    local rate = sessionRebirths / hours
    local strengthText = lastStrengthDisplay or (lastGainValue and formatNumber(lastGainValue)) or "unavailable"
    local gainRate = sessionGain and sessionGain / hours or nil

    if sessionStats then
        local rebirthText = lastRebirthDisplay and ("Rebirth: " .. lastRebirthDisplay) or "Rebirth: n/a"
        sessionStats.Text = string.format(
            "%s  •  Rebirths: %d  •  %.1f/hr",
            rebirthText, sessionRebirths, rate
        )
    end

    if not statsLabel then return end
    statsLabel.Text = string.format(
        "Farm: %s\nWatchdog: %s\nRecoveries: %d\nStrength: %s\nGain/hour: %s",
        farmName, watchdogStatus, totalRecoveries, strengthText, gainRate and formatNumber(gainRate) or "unavailable"
    )
end

local function safeReadSettings()
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return nil end
    local ok, exists = pcall(isfile, settingsFile)
    if not ok or not exists then return nil end
    local ok2, raw = pcall(readfile, settingsFile)
    if not ok2 or type(raw) ~= "string" or raw == "" then return nil end
    local ok3, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    return ok3 and type(data) == "table" and data or nil
end

local function safeWriteSettings()
    if typeof(writefile) ~= "function" then return end
    local ok, raw = pcall(function()
        return game:GetService("HttpService"):JSONEncode({
            farmForever = farmForever,
            autoRecover = autoRecover,
            hoverHeight = hoverHeight,
            minimized = minimized,
        })
    end)
    if ok and raw then pcall(writefile, settingsFile, raw) end
end

local function loadSavedSettings()
    local data = safeReadSettings()
    if not data then return end
    if type(data.farmForever) == "boolean" then farmForever = data.farmForever end
    if type(data.autoRecover) == "boolean" then autoRecover = data.autoRecover end
    if type(data.hoverHeight) == "number" then hoverHeight = math.clamp(data.hoverHeight, 2, 30) end
    if type(data.minimized) == "boolean" then minimized = data.minimized end
end

local function getCharacter()
    local character = player.Character
    if not character then
        return nil, nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not root:IsA("BasePart")
        or not humanoid or humanoid.Health <= 0 then
        return nil, nil
    end

    return character, root
end

